---
import PostCard from "../../../components/blog/PostCard.astro";
import PageLayout from "../../../layouts/PageLayout.astro";
import { getPublishedPosts, postTagsOf, type Post } from "../../../lib/posts";
import { postTags, type PostTag } from "../../../data/tags";
import { filterByTag, summarizeTags } from "../../../lib/tags";

interface Props {
  tag: PostTag;
  posts: Post[];
}

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return summarizeTags(posts, postTagsOf, postTags).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: filterByTag(posts, tag, postTagsOf) },
  }));
}

const { tag, posts } = Astro.props;
const label = postTags[tag];
---

<PageLayout
  pageType="CollectionPage"
  title={`Posts tagged ${label}`}
  description={`Posts tagged ${label}.`}
>
  <h1 class="mb-6 text-3xl font-bold">Posts tagged {label}</h1>
  <p class="mb-6">
    <a href="/blog/tags/" class="underline">
      All Post tags
    </a>
  </p>
  <ul class="space-y-4">
    {posts.map((post) => (
      <li>
        <PostCard post={post} />
      </li>
    ))}
  </ul>
</PageLayout>
