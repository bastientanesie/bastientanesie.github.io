---
import TagIndex from "../../../components/TagIndex.astro";
import PageLayout from "../../../layouts/PageLayout.astro";
import { getPublishedPosts } from "../../../lib/posts";
import { summarizeTags } from "../../../lib/tags";

const tags = summarizeTags(await getPublishedPosts());
---

<PageLayout
  pageType="CollectionPage"
  title="Post tags"
  description="Browse Posts by tag."
>
  <h1 class="mb-6 text-3xl font-bold">Post tags</h1>
  <TagIndex tags={tags} basePath="/blog/tags/" />
</PageLayout>
