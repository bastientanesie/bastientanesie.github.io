---
import TagIndex from "../../../components/TagIndex.astro";
import PageLayout from "../../../layouts/PageLayout.astro";
import { postTags } from "../../../data/tags";
import { getPublishedPosts, postTagsOf } from "../../../lib/posts";
import { summarizeTags } from "../../../lib/tags";

const tags = summarizeTags(await getPublishedPosts(), postTagsOf, postTags);
---

<PageLayout
  pageType="CollectionPage"
  title="Post tags"
  description="Browse Posts by tag."
>
  <h1 class="mb-6 text-3xl font-bold">Post tags</h1>
  <TagIndex groups={[{ tags }]} basePath="/blog/tags/" />
</PageLayout>
