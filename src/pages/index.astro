---
import PostCard from "../components/blog/PostCard.astro";
import ProjectCard from "../components/projects/ProjectCard.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { getPublishedPosts } from "../lib/posts";
import { getPublishedProjects } from "../lib/projects";

const LATEST_POSTS_COUNT = 3;

const latestPosts = (await getPublishedPosts()).slice(0, LATEST_POSTS_COUNT);
const featuredProjects = (await getPublishedProjects()).filter(
  ({ data }) => data.isFeatured,
);
---

<PageLayout
  title="Bastien Tanésie — Laravel & PHP Web Developer"
  description="Bastien Tanésie, web developer with 15 years of PHP experience. Articles on Laravel, Ansible and DevOps, plus projects I've built."
>
  <h1 class="text-3xl font-bold">Bastien Tanésie</h1>
  <section class="mt-8" aria-labelledby="latest-posts">
    <h2 id="latest-posts" class="mb-4 text-2xl font-semibold">
      Latest posts
    </h2>
    <ul class="space-y-4">
      {latestPosts.map((post) => (
        <li>
          <PostCard post={post} headingLevel="h3" />
        </li>
      ))}
    </ul>
    <p class="mt-4">
      <a href="/blog/" class="underline underline-offset-4">
        All posts
      </a>
    </p>
  </section>
  <section class="mt-12" aria-labelledby="featured-projects">
    <h2 id="featured-projects" class="mb-4 text-2xl font-semibold">
      Featured projects
    </h2>
    <ul class="space-y-4">
      {featuredProjects.map((project) => (
        <li>
          <ProjectCard project={project} headingLevel="h3" />
        </li>
      ))}
    </ul>
    <p class="mt-4">
      <a href="/projects/" class="underline underline-offset-4">
        All projects
      </a>
    </p>
  </section>
</PageLayout>
