---
import type { GetStaticPaths } from "astro";
import About from "../drafts/about.astro";

const drafts = { about: About };

export const getStaticPaths = (() =>
  import.meta.env.DEV
    ? [{ params: { draft: "about" } }]
    : []) satisfies GetStaticPaths;

const Draft = drafts[Astro.params.draft as keyof typeof drafts];
---

<Draft />
