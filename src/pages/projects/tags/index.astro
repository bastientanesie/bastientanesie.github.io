---
import TagIndex from "../../../components/TagIndex.astro";
import PageLayout from "../../../layouts/PageLayout.astro";
import { getPublishedProjects } from "../../../lib/projects";
import { summarizeTags } from "../../../lib/tags";

const tags = summarizeTags(await getPublishedProjects());
---

<PageLayout
  pageType="CollectionPage"
  title="Project tags"
  description="Browse Projects by tag."
>
  <h1 class="mb-6 text-3xl font-bold">Project tags</h1>
  <TagIndex tags={tags} basePath="/projects/tags/" />
</PageLayout>
