---
import TagIndex from "../../../components/TagIndex.astro";
import PageLayout from "../../../layouts/PageLayout.astro";
import {
  projectSkillTags,
  projectTags,
  projectTechTags,
} from "../../../data/tags";
import { getPublishedProjects, projectTagsOf } from "../../../lib/projects";
import { summarizeTags } from "../../../lib/tags";

const summaries = summarizeTags(
  await getPublishedProjects(),
  projectTagsOf,
  projectTags,
);
const groups = [
  { name: "Tech tags", labels: projectTechTags },
  { name: "Skill tags", labels: projectSkillTags },
].map(({ name, labels }) => ({
  name,
  tags: summaries.filter(({ tag }) => tag in labels),
}));
---

<PageLayout
  pageType="CollectionPage"
  title="Project tags"
  description="Browse Projects by tag."
>
  <h1 class="mb-6 text-3xl font-bold">Project tags</h1>
  <TagIndex groups={groups} basePath="/projects/tags/" />
</PageLayout>
