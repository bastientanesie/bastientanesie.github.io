---
import type { MarkdownHeading } from "astro";
import { Picture } from "astro:assets";
import AiBadge from "../components/blog/AiBadge.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import { readingTimeMinutes, type Post } from "../lib/posts";
import PageLayout from "./PageLayout.astro";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, publishedAt, cover, aiAssisted, tags } = post.data;
---

<PageLayout title={`${title} | Bastien Tanésie`} description={description}>
  <article class="mx-auto max-w-3xl">
    <header class="mb-6">
      <h1 class="text-3xl font-bold">{title}</h1>
      <p class="text-muted mt-2 text-sm">
        <time datetime={publishedAt.toISOString()}>
          {publishedAt.toISOString().slice(0, 10)}
        </time>
        · {readingTimeMinutes(post.body)} min read
        {aiAssisted && <AiBadge />}
      </p>
      <ul class="mt-2 flex gap-2 text-sm" aria-label="Tags">
        {tags.map((tag) => (
          <li class="text-muted">#{tag}</li>
        ))}
      </ul>
    </header>
    {cover && (
      <Picture
        src={cover.image}
        alt={cover.alt}
        widths={[480, 720, 1080]}
        sizes="(min-width: 48rem) 720px, 100vw"
        formats={["avif", "webp"]}
        class="mb-6 rounded"
      />
    )}
    <TableOfContents headings={headings} />
    <div class="prose-post space-y-4">
      <slot />
    </div>
  </article>
</PageLayout>
