---
import type { MarkdownHeading } from "astro";
import PostCover from "../components/blog/PostCover.astro";
import PostMeta from "../components/blog/PostMeta.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import { postTags } from "../data/tags";
import type { Post } from "../lib/posts";
import { ogImagePath } from "../lib/og-image";
import { buildPostNode, resolveSite } from "../lib/seo";
import PageLayout from "./PageLayout.astro";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, tags } = post.data;
const nodes = [buildPostNode(post, resolveSite(Astro))];
---

<PageLayout
  title={title}
  description={description}
  nodes={nodes}
  image={ogImagePath("blog", post.id)}
  ogType="article"
>
  <article class="mx-auto max-w-3xl">
    <header class="mb-6">
      <h1 class="text-3xl font-bold">{title}</h1>
      <div class="mt-2">
        <PostMeta post={post} />
      </div>
      <ul class="mt-2 flex gap-2 text-sm" aria-label="Tags">
        {tags.map((tag) => (
          <li>
            <a
              href={`/blog/tags/${tag}/`}
              class="text-muted underline-offset-4 hover:underline"
            >
              {postTags[tag]}
            </a>
          </li>
        ))}
      </ul>
    </header>
    <PostCover post={post} class="mb-6" />
    <TableOfContents headings={headings} />
    <div class="prose-content space-y-4">
      <slot />
    </div>
  </article>
</PageLayout>
