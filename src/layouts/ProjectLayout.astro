---
import type { MarkdownHeading } from "astro";
import ProjectLogo from "../components/projects/ProjectLogo.astro";
import ProjectMeta from "../components/projects/ProjectMeta.astro";
import TableOfContents from "../components/shared/TableOfContents.astro";
import { projectSkillTags, projectTechTags } from "../data/tags";
import type { Project } from "../lib/projects";
import { ogImagePath } from "../lib/og-image";
import { buildProjectNode, resolveSite } from "../lib/seo";
import PageLayout from "./PageLayout.astro";

interface Props {
  project: Project;
  headings: MarkdownHeading[];
}

const { project, headings } = Astro.props;
const { title, description, techTags, skillTags } = project.data;
const tagGroups = [
  { name: "Tech tags", tags: techTags, labels: projectTechTags },
  { name: "Skill tags", tags: skillTags, labels: projectSkillTags },
];
const nodes = [buildProjectNode(project, resolveSite(Astro))];
---

<PageLayout
  title={title}
  description={description}
  nodes={nodes}
  image={ogImagePath("projects", project.id)}
>
  <article class="mx-auto max-w-3xl">
    <header class="mb-6 flex items-center gap-4">
      <ProjectLogo project={project} class="shrink-0" />
      <div>
        <h1 class="text-3xl font-bold">{title}</h1>
        <div class="mt-2">
          <ProjectMeta project={project} />
        </div>
        {tagGroups.map(({ name, tags, labels }) => (
          <ul class="mt-2 flex flex-wrap gap-2 text-sm" aria-label={name}>
            {tags.map((tag) => (
              <li>
                <a
                  href={`/projects/tags/${tag}/`}
                  class="text-muted underline-offset-4 hover:underline"
                >
                  {labels[tag as keyof typeof labels]}
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </header>
    <TableOfContents headings={headings} />
    <div class="prose-content space-y-4">
      <slot />
    </div>
  </article>
</PageLayout>
