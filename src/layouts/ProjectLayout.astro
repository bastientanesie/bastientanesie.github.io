---
import ProjectLogo from "../components/projects/ProjectLogo.astro";
import ProjectMeta from "../components/projects/ProjectMeta.astro";
import type { Project } from "../lib/projects";
import { buildProjectNode, resolveSite } from "../lib/seo";
import PageLayout from "./PageLayout.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, tags } = project.data;
const nodes = [buildProjectNode(project, resolveSite(Astro))];
---

<PageLayout
  title={`${title} | Bastien Tanésie`}
  description={description}
  nodes={nodes}
  image={`/og/projects/${project.id}.png`}
>
  <article class="mx-auto max-w-3xl">
    <header class="mb-6 flex items-center gap-4">
      <ProjectLogo project={project} class="shrink-0" />
      <div>
        <h1 class="text-3xl font-bold">{title}</h1>
        <div class="mt-2">
          <ProjectMeta project={project} />
        </div>
        <ul class="mt-2 flex gap-2 text-sm" aria-label="Tags">
          {tags.map((tag) => (
            <li>
              <a
                href={`/projects/tags/${tag}/`}
                class="text-muted underline-offset-4 hover:underline"
              >
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </header>
    <div class="prose-content space-y-4">
      <slot />
    </div>
  </article>
</PageLayout>
