---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import ThemeScript from "../components/ThemeScript.astro";
import { themeColors } from "../data/site";
import type { JsonLdNode, PageType } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  pageType?: PageType | undefined;
  nodes?: JsonLdNode[] | undefined;
  image?: string | undefined;
}

const {
  title,
  description,
  noindex = false,
  pageType,
  nodes,
  image,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      noindex={noindex}
      pageType={pageType}
      nodes={nodes}
      image={image}
    />
    <meta
      name="theme-color"
      content={themeColors.light}
      media="(prefers-color-scheme: light)"
      data-scheme="light"
    />
    <meta
      name="theme-color"
      content={themeColors.dark}
      media="(prefers-color-scheme: dark)"
      data-scheme="dark"
    />
    <ThemeScript />
  </head>
  <body class="min-h-screen bg-surface text-content antialiased">
    <slot />
  </body>
</html>
