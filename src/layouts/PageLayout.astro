---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import type { SeoProps } from "../lib/seo";
import BaseLayout from "./BaseLayout.astro";

type Props = SeoProps;

const seo = Astro.props;
---

<BaseLayout {...seo}>
  <a
    href="#main"
    data-print-hidden
    class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:bg-surface focus:px-3 focus:py-2"
  >
    Skip to content
  </a>
  <Header />
  <main id="main" class="page-container py-8">
    <slot />
  </main>
  <Footer />
</BaseLayout>
