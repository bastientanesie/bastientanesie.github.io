---
import { Image } from "astro:assets";
import type { Project } from "../../lib/projects";

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className } = Astro.props;
const { logo } = project.data;
---

<Image
  src={logo.image}
  alt={logo.alt}
  width={64}
  height={64}
  class:list={["rounded", className]}
/>
