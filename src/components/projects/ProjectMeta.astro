---
import type { Project } from "../../lib/projects";

interface Props {
  project: Project;
}

const { role, startedAt, endedAt } = Astro.props.project.data;
---

<p class="text-muted text-sm">
  {role} · <time datetime={startedAt}>{startedAt}</time>
  {" – "}
  {endedAt ? <time datetime={endedAt}>{endedAt}</time> : "present"}
</p>
