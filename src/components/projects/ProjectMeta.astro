---
import type { Project } from "../../lib/projects";
import { formatYearMonth } from "../../lib/year-month";

interface Props {
  project: Project;
}

const { role, client, employer, startedAt, endedAt } = Astro.props.project.data;
const clientLabel = employer ? `${client} (via ${employer})` : client;
---

<p class="text-muted text-sm">
  {`${role} · ${clientLabel} · `}
  <time datetime={startedAt}>{formatYearMonth(startedAt)}</time>
  {" – "}
  {endedAt ? (
    <time datetime={endedAt}>{formatYearMonth(endedAt)}</time>
  ) : (
    "present"
  )}
</p>
