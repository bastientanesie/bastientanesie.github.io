---
import type { Project } from "../../lib/projects";
import { formatYearMonth } from "../../lib/year-month";

interface Props {
  project: Project;
}

const { role, startedAt, endedAt } = Astro.props.project.data;
---

<p class="text-muted text-sm">
  {role} · <time datetime={startedAt}>{formatYearMonth(startedAt)}</time>
  {" – "}
  {endedAt ? (
    <time datetime={endedAt}>{formatYearMonth(endedAt)}</time>
  ) : (
    "present"
  )}
</p>
