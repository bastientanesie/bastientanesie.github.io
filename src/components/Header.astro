---
import NavList from "./NavList.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

const currentPath = Astro.url.pathname;
---

<header class="border-b border-border" data-print-hidden>
  <div class="page-container flex items-center justify-between gap-4 py-3">
    <a href="/" class="font-semibold">
      Bastien Tanésie
    </a>

    <div class="hidden md:block">
      <NavList
        label="Main"
        currentPath={currentPath}
        listClass="flex gap-6"
        linkClass=""
      />
    </div>

    <div class="flex items-center gap-3">
      <div class="hidden xs:block">
        <ThemeSwitcher groupName="theme" />
      </div>
      <button
        type="button"
        popovertarget="mobile-menu"
        class="rounded-md border border-border px-3 py-1 text-sm md:hidden"
      >
        Menu
      </button>
    </div>
  </div>

  <div id="mobile-menu" popover class="mobile-menu md:hidden">
    <NavList
      label="Mobile"
      currentPath={currentPath}
      listClass="flex flex-col gap-4"
      linkClass="block py-1"
    />
    <div class="mt-4 xs:hidden">
      <ThemeSwitcher groupName="theme-mobile" />
    </div>
  </div>
</header>
