---
import { navigation } from "../data/site";
import ThemeSwitcher from "./ThemeSwitcher.astro";

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="border-b border-border" data-print-hidden>
  <div class="mx-auto flex max-w-[2560px] items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="font-semibold">
      Bastien Tanésie
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex gap-6">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class="underline-offset-4 hover:underline aria-[current=page]:underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <ThemeSwitcher />
      <button
        type="button"
        popovertarget="mobile-menu"
        class="rounded-md border border-border px-3 py-1 text-sm md:hidden"
      >
        Menu
      </button>
    </div>
  </div>

  <div id="mobile-menu" popover class="mobile-menu md:hidden">
    <nav aria-label="Mobile">
      <ul class="flex flex-col gap-4">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class="block py-1 underline-offset-4 hover:underline aria-[current=page]:underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
