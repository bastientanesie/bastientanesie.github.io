---
import type { Post } from "../../lib/posts";
import PostCover from "./PostCover.astro";
import PostMeta from "./PostMeta.astro";

interface Props {
  post: Post;
  headingLevel?: "h2" | "h3";
}

const { post, headingLevel: Heading = "h2" } = Astro.props;
const { title, description } = post.data;
---

<article class="relative rounded-md border border-border p-4">
  <PostCover post={post} class="mb-3" />
  <Heading class="text-xl font-semibold">
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">
      {title}
    </a>
  </Heading>
  <PostMeta post={post} />
  <p class="mt-2">{description}</p>
</article>
