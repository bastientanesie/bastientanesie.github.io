---
const options = [
  { value: "light", label: "Light" },
  { value: "dark", label: "Dark" },
  { value: "system", label: "System" },
] as const;
---

<fieldset data-theme-switcher hidden class="flex items-center gap-1">
  <legend class="sr-only">Theme</legend>
  {options.map((option) => (
    <label class="cursor-pointer rounded-md border border-border px-2 py-1 text-sm has-checked:bg-content has-checked:text-surface has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-focus">
      <input
        type="radio"
        name="theme"
        value={option.value}
        class="sr-only"
        checked={option.value === "system"}
      />
      {option.label}
    </label>
  ))}
</fieldset>
