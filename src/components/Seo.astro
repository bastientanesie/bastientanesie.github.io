---
import {
  buildJsonLdGraph,
  resolveSite,
  serializeJsonLd,
  SITE_NAME,
  type JsonLdNode,
  type PageType,
} from "../lib/seo";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  pageType?: PageType | undefined;
  nodes?: JsonLdNode[] | undefined;
}

const { title, description, noindex = false, pageType, nodes } = Astro.props;

const site = resolveSite(Astro);
const canonical = new URL(Astro.url.pathname, site);
const graph = noindex
  ? undefined
  : serializeJsonLd(
      buildJsonLdGraph({
        site,
        url: canonical,
        title,
        description,
        pageType,
        nodes,
      }),
    );
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical.href} />}
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="en" />
{!noindex && <meta property="og:url" content={canonical.href} />}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_NAME} — Blog`}
  href="/rss.xml"
/>
{graph && (
  <script is:inline type="application/ld+json" set:html={graph}></script>
)}
