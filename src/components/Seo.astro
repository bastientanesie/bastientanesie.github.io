---
import { getImage } from "astro:assets";
import defaultOgImage from "../assets/og-default.png";
import {
  buildJsonLdGraph,
  resolveSite,
  serializeJsonLd,
  SITE_NAME,
  type JsonLdNode,
  type PageType,
} from "../lib/seo";
import { OG_HEIGHT, OG_WIDTH } from "../lib/og-image";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  pageType?: PageType | undefined;
  nodes?: JsonLdNode[] | undefined;
  image?: string | undefined;
}

const {
  title,
  description,
  noindex = false,
  pageType,
  nodes,
  image,
} = Astro.props;

const site = resolveSite(Astro);
const canonical = new URL(Astro.url.pathname, site);
const imagePath =
  image ?? (await getImage({ src: defaultOgImage, format: "png" })).src;
const imageUrl = new URL(imagePath, site).href;
const graph = noindex
  ? undefined
  : serializeJsonLd(
      buildJsonLdGraph({
        site,
        url: canonical,
        title,
        description,
        pageType,
        nodes,
      }),
    );
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical.href} />}
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="en" />
<meta property="og:type" content="website" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta name="twitter:card" content="summary_large_image" />
{!noindex && <meta property="og:url" content={canonical.href} />}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_NAME} — Blog`}
  href="/rss.xml"
/>
{graph && (
  <script is:inline type="application/ld+json" set:html={graph}></script>
)}
