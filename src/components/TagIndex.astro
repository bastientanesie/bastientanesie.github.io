---
import type { TagSummary } from "../lib/tags";

interface Props {
  groups: { name?: string; tags: TagSummary<string>[] }[];
  basePath: string;
}

const { groups, basePath } = Astro.props;
---

<div x-data="tagFilter">
  <label class="invisible mb-4 block" x-bind:class="filterClasses">
    <span class="mb-1 block text-sm">Filter tags</span>
    <input
      type="search"
      x-model="query"
      class="w-full max-w-xs rounded-md border border-border px-2 py-1"
    />
  </label>
  {groups.map(({ name, tags }) => (
    <section class="mb-6">
      {name && <h2 class="mb-2 text-lg font-semibold">{name}</h2>}
      <ul class="flex flex-wrap gap-2" aria-label={name ?? "Tags"}>
        {tags.map(({ tag, label, count }) => (
          <li data-tag={`${label} ${tag}`.toLowerCase()} x-show="isMatching">
            <a
              href={`${basePath}${tag}/`}
              class="rounded-md border border-border px-2 py-1 text-sm underline-offset-4 hover:underline"
            >
              {label} <span class="text-muted">({count})</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
